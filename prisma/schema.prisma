generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  employeeId         String          @unique
  fullName           String
  passwordHash       String
  mustChangePassword Boolean         @default(true)
  role               String          @default("EMPLOYEE") // SUPER_ADMIN, CEO, COO, CTO, CFO, CMO, CAO, EMPLOYEE, INTERN
  departmentId       String?
  department         Department?     @relation(fields: [departmentId], references: [id])
  designation        String
  accountStatus      String          @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joiningDate        DateTime        @default(now())
  reportingManagerId String?
  reportingManager   User?           @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates       User[]          @relation("ManagerSubordinates")
  skills             String          @default("") // Comma separated or JSON string
  avatarUrl          String?
  lastActive         DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relationships
  managedProjects    Project[]       @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  createdTasks       Task[]          @relation("TaskCreator")
  comments           TaskComment[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  announcements      Announcement[]
  uploadedDocs       Document[]
  taskAttachments    TaskAttachment[]

  @@index([role])
  @@index([departmentId])
  @@index([accountStatus])
}

model Department {
  id            String         @id @default(cuid())
  name          String         @unique
  code          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  users         User[]
  announcements Announcement[]
}

model Project {
  id          String          @id @default(cuid())
  projectId   String          @unique // e.g. T2T-PRJ-01
  name        String
  description String
  managerId   String
  manager     User            @relation("ProjectManager", fields: [managerId], references: [id])
  startDate   DateTime
  targetDate  DateTime
  status      String          @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  priority    String          @default("HIGH") // LOW, MEDIUM, HIGH, URGENT
  progress    Int             @default(0) // 0-100%
  budget      Float?          @default(0)
  risks       String?         @default("")
  blockers    String?         @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  members     ProjectMember[]
  tasks       Task[]
  sprints     Sprint[]
  milestones  Milestone[]
  documents   Document[]

  @@index([status])
  @@index([priority])
}

model ProjectMember {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String   @default("Contributor")
  assignedAt    DateTime @default(now())

  @@unique([projectId, userId])
}

model Sprint {
  id          String    @id @default(cuid())
  name        String // e.g. Sprint 14 - Smart Waste AI
  goal        String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, CANCELLED
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewNotes String?
  retroNotes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]
  documents   Document[]

  @@index([status])
  @@index([projectId])
}

model Task {
  id              String           @id @default(cuid())
  taskId          String           @unique // e.g. T2T-1001
  title           String
  description     String
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId        String?
  sprint          Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User             @relation("TaskCreator", fields: [createdById], references: [id])
  priority        String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String           @default("TODO") // BACKLOG, TODO, IN_PROGRESS, IN_REVIEW, BLOCKED, COMPLETED, CANCELLED
  startDate       DateTime?
  dueDate         DateTime?
  estimatedEffort Float            @default(0) // in hours
  actualEffort    Float            @default(0) // in hours
  storyPoints     Int              @default(1)
  tags            String           @default("") // comma separated
  blockers        String?
  dependencies    String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  comments        TaskComment[]
  attachments     TaskAttachment[]
  documents       Document[]

  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  status      String    @default("PENDING") // PENDING, COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // TASK_ASSIGNED, SPRINT_UPDATE, COMMENT, DEADLINE, ANNOUNCEMENT, SYSTEM
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Announcement {
  id                 String      @id @default(cuid())
  title              String
  content            String
  priority           String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  authorId           String
  author             User        @relation(fields: [authorId], references: [id])
  isPinned           Boolean     @default(false)
  targetDepartmentId String?
  targetDepartment   Department? @relation(fields: [targetDepartmentId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Document {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  category     String   @default("GENERAL") // GENERAL, SPEC, PROPOSAL, SPRINT, CONTRACT
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sprintId     String?
  sprint       Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String // CREATED, UPDATED, DELETED, STATUS_CHANGE, ASSIGNED, COMPLETED, LOGIN, PASSWORD_CHANGE
  objectType    String // TASK, PROJECT, SPRINT, USER, ANNOUNCEMENT, DOCUMENT
  objectId      String?
  objectTitle   String
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([objectType])
  @@index([action])
  @@index([createdAt])
}
